{
  "name": "licc.gov",
  "version": "0.1.0",
  "private": true,
  "description": "LICC Gov Graph — catálogo relacional em grafo da Lei de Incentivo à Cultura Capixaba (SECULT-ES)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx --env-file-if-exists=.env pipeline/ingest.ts",
    "build:graph": "tsx --env-file-if-exists=.env pipeline/build-graph.ts",
    "data": "npm run ingest && npm run build:graph",
    "scrape:secult": "tsx --env-file-if-exists=.env pipeline/scrape-secult.ts",
    "merge:patrocinadores": "tsx --env-file-if-exists=.env pipeline/importar-patrocinadores.ts"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
